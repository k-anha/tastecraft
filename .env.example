# ================================================================
# TasteCraft - Environment Configuration Template
# Duplicate this file as '.env' and fill in your real credentials locally.
# DO NOT commit '.env' containing real secrets to GitHub!
# ================================================================

# PostgreSQL Database Connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# If your password contains special characters like '@', URL-encode it (e.g., '@' -> '%40')
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/tastecraft_db

# Alternative: Separate connection variables
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password_here
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=tastecraft_db

# JWT & Security Configuration
# In production, generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

